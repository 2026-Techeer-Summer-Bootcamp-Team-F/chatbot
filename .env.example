# NimbusPay 챗봇 환경변수 설정
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 사용하세요.
# cp .env.example .env

# Ollama 설정
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
TEMPERATURE=0.7

# 챗봇 내부 설정 (스캔 canary 값과 일치해야 함)
SESSION_TOKEN=
DB_PASSWORD=
PAYMENT_KEY=

# 데모 사용자 컨텍스트 (선택)
DEMO_USER_NAME=
DEMO_USER_CARD=
DEMO_USER_BALANCE=

# 서버 설정 (선택)
HOST=0.0.0.0
PORT=8100
